{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/engine/test_bot.ts",
    "src/engine/benchmark.ts",
    "src/engine/squashBot.ts",
    "src/engine/squashBotEval.ts",
    "src/engine/selfplay.ts", "src/engine/selfplayTimed.ts",
    "src/engine/selfplayZoom.ts",
    "src/engine/selfplayZoomNonShan.ts",
    "src/engine/selfplayZoomShanOnly.ts",
    "src/engine/selfplayZoomTimed.ts",
    "src/engine/selfplayZoomVsShan.ts",
    "src/engine/selfplayZoomVsSquash.ts",
    "src/engine/selfplayZoomVsSquashTimed.ts",
    "src/engine/selfplaySquashV2.ts",
    "src/engine/selfplaySquashV2Timed.ts",
    "src/engine/selfplaySquashV2VsZoom.ts",
    "src/engine/squashV2Ablation.ts",
    "src/engine/replayTest.ts",
    "src/engine/cloneTest.ts",
    "src/engine/seekLeakTest.ts",
    "src/engine/twitchBot.ts",
    "src/engine/twitchDebug.ts",
    "src/engine/twitchEval.ts",
    "src/engine/v3head2head.ts",
    "src/engine/v3ablation.ts",
    "src/engine/anvilEvolve.ts",
    "src/engine/anvilBench.ts",
    "src/engine/valueDataGen.ts",
    "src/engine/valueTrain.ts",
    "src/engine/henryReplayGen.ts",
    "src/engine/henryDivergence.ts",
    "src/engine/selfplaySquashV2VsZoomBase.ts",
    "src/engine/selfplaySquashV3Mirror.ts"
  ]
}
